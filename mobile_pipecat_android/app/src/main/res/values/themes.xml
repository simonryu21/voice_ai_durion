<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.CodeEngine" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.WebViewTest" parent="Theme.MaterialComponents.Light.NoActionBar"/>

    <!-- 팝업형 웹뷰 스타일 -->
    <style name="CustomWebViewDialogTheme">
        <!-- 커스텀뷰 적용을 위해 백그라운드 투명 적용 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <!-- 바깥영역 터치 시 dismiss 처리 -->
        <item name="android:windowCloseOnTouchOutside">false</item>
        <!-- Dialog 가 센터에 나오도록 처리 -->
        <item name="android:windowIsFloating">true</item>
    </style>

    <!-- Dialog Style -->
    <style name="CustomDialogTheme">
        <!-- 커스텀뷰 적용을 위해 백그라운드 투명 적용 -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <!-- 바깥영역 터치 시 dismiss 처리 -->
        <item name="android:windowCloseOnTouchOutside">true</item>
        <!-- Dialog 가 센터에 나오도록 처리 -->
        <item name="android:windowIsFloating">true</item>
    </style>

</resources>