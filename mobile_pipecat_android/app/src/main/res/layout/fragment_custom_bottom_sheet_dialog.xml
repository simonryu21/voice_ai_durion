<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:fontFamily="@font/opensans_regular"
            android:gravity="center_vertical"
            android:paddingBottom="22dp"
            android:textColor="@color/grey_900"
            android:textSize="16dp"
            app:layout_constraintEnd_toStartOf="@id/closeBtn"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="타이틀 영역" />

        <ImageView
            android:id="@+id/closeBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="4dp"
            android:src="@drawable/ic_close_medium_grey900"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:textColor="@color/grey_900"
            android:textSize="14dp"
            app:layout_constraintTop_toBottomOf="@id/title"
            tools:text="메시지 영역" />

        <TextView
            android:id="@+id/highlightedMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/opensans_regular"
            android:gravity="center_vertical"
            android:textColor="@color/blue_800"
            android:textSize="16dp"
            app:layout_constraintTop_toBottomOf="@id/message"
            tools:text="하이라이트 메시지 영역" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/positiveButton"
            style="@style/ButtonComponents.XLarge.1st"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/opensans_regular"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="6"
            app:layout_constraintStart_toEndOf="@id/negativeButton"
            app:layout_constraintTop_toBottomOf="@id/highlightedMessage"
            tools:text="확인" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/negativeButton"
            style="@style/ButtonComponents.XLarge.4th"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:fontFamily="@font/opensans_regular"
            android:maxLines="1"
            app:layout_constraintBottom_toBottomOf="@id/positiveButton"
            app:layout_constraintEnd_toStartOf="@id/positiveButton"
            app:layout_constraintHorizontal_weight="4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/positiveButton"
            tools:text="취소" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>