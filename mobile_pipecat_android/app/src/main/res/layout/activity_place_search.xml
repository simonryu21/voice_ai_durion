<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="15dp"
                android:layout_weight="1"
                android:background="@drawable/search_input_background">

                <EditText
                    android:id="@+id/etSearch"
                    android:fontFamily="@font/opensans_regular"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:background="@null"
                    android:hint="@string/main_search_hint"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions"
                    android:paddingLeft="16dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/main_search_hint_color"
                    android:textSize="15dp" />

            </RelativeLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="20dp"
                android:layout_gravity="right"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:id="@+id/ivClose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_appbar_close" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llQuickFavoriteRoute"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:layout_below="@+id/ll_search_method_bottom"
            android:background="@color/white_nearly"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llQuickFavoriteRouteInner"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">

                <TextView
                    android:id="@+id/tvRecentSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginRight="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/horizontal_twilight_line"
                    android:fontFamily="@font/opensans_regular"
                    android:gravity="center"
                    android:text="@string/recent_search"
                    android:textColor="@color/charcoal_grey"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/tvPlaceFav"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:fontFamily="@font/opensans_regular"
                    android:gravity="center"
                    android:text="장소 즐겨찾기"
                    android:textColor="@color/slate_grey"
                    android:textSize="16dp" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="90dp"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="32dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/opensans_regular"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/slate_grey"
                    android:textSize="16dp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:id="@+id/vDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/pale_sky_blue"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleSearchResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="visible"
            tools:listitem="@layout/place_item_layout"
            tools:itemCount="5"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/navi_second_depth_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/ivAlert"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/tvNoData"
                app:layout_constraintVertical_chainStyle="packed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:src="@drawable/img_empty" />

            <TextView
                android:id="@+id/tvNoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/ivAlert"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:fontFamily="@font/opensans_regular"
                android:gravity="center"
                android:text="@string/search_no_result"
                android:textColor="@color/empty_notice"
                android:textSize="15dp" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</layout>