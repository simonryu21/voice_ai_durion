DEEPGRAM_API_KEY=your_deepgram_api_key
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o
CARTESIA_API_KEY=your_cartesia_api_key

# STT Provider: 'google' or 'soniox' (default: google)
STT_PROVIDER=google

# STT 오디오 입력 타임아웃 (초) - CPU 부하 시 단어 누락 방지 (기본값: 1.5초)
# 값이 클수록 CPU 부하에 더 잘 대응하지만 응답 지연이 증가할 수 있음
AUDIO_INPUT_TIMEOUT_SECS=1.5

# STT 오디오 프레임 수신 타임아웃 (초) - CPU 부하 시 단어 누락 방지 (기본값: 3.0초)
AUDIO_FRAME_TIMEOUT_SECS=3.0

# WebRTC idle 타임아웃 (초) - old frame 버리기 빈도 조절 (기본값: 60.0초)
# STT 단어 누락 방지를 위해 기본값을 60초로 설정
# 값이 클수록 프레임이 덜 자주 버려지지만 메모리 사용량이 증가할 수 있음
WEBRTC_IDLE_TIMEOUT_SECS=60.0

# WebRTC 큐 크기 임계값 - 큐가 이 값 이상일 때만 old frame 버리기 (기본값: 100)
# STT 단어 누락 방지를 위해 큐가 100개 이상 쌓일 때만 프레임을 버림
# 값이 클수록 프레임이 덜 버려지지만 메모리 사용량이 증가할 수 있음
WEBRTC_QUEUE_SIZE_THRESHOLD=100

# WebRTC 메시지 큐 크기 - 데이터 채널을 통한 메시지 전송 큐 크기 (기본값: 100)
# 회의 모드 등에서 transcription 메시지가 많이 생성될 때 큐 크기 제한
# 큐가 가득 차면 오래된 메시지를 드롭하여 메모리 오버플로우 방지
# 값이 클수록 더 많은 메시지를 버퍼링하지만 메모리 사용량이 증가할 수 있음
WEBRTC_MESSAGE_QUEUE_SIZE=100

# Google Cloud STT (required when STT_PROVIDER=google)
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
# GOOGLE_CLOUD_CREDENTIALS={"type":"service_account",...}

# Soniox STT (required when STT_PROVIDER=soniox)
SONIOX_API_KEY=your_soniox_api_key
# 회사망 등에서 SSL 인증서 검증 실패 시: SONIOX_SSL_VERIFY=false (보안상 비권장, 개발/내부망 전용)
# SONIOX_SSL_VERIFY=false

# mem0(PostHog) 텔레메트리 비활성화 - 회사망에서 us.i.posthog.com SSL 오류 방지
# MEM0_TELEMETRY=false
# 또는 PostHog만 끄기: DISABLE_POSTHOG=true

# Optional: Connect via Daily WebRTC locally
DAILY_API_KEY=your_daily_api_key

# Optional: OpenWeatherMap API (for weather information)
# Get your API key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key

# Optional: Naver Local Search API (for nearby places)
# Get your API key from: https://developers.naver.com/docs/serviceapi/search/local/
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Optional: Naver Cloud Platform Maps API (for address geocoding - coordinate to address conversion)
# Get your API keys from: https://www.ncloud.com/product/applicationService/maps
# 네이버 클라우드 플랫폼에서 Maps API 서비스를 신청하고 Application을 등록한 후 Client ID와 Client Secret을 발급받아 설정하세요
# ⚠️ 중요: IAM Access Key가 아닌 Application의 Client ID/Secret을 사용해야 합니다!
# 참고: https://wooiljeong.github.io/python/reverse-geocoding/
NAVER_MAPS_API_KEY_ID=your_naver_maps_client_id
NAVER_MAPS_API_KEY=your_naver_maps_client_secret

# Optional: Mem0 API (for memory/personalization features)
# Get your API key from: https://mem0.ai/
MEM0_API_KEY=your_mem0_api_key
# Mem0 API endpoint (default: http://localhost:8888 for local installation)
MEM0_HOST=http://localhost:8888

# Optional: Tavily Search API (for web search - better quality than DuckDuckGo)
# Get your API key from: https://app.tavily.com/
# Free tier: 1,000 searches/month
# If not set, will fallback to DuckDuckGo
TAVILY_API_KEY=your_tavily_api_key
# Optional: Preferred search provider ('tavily' or 'duckduckgo', default: 'tavily')
WEB_SEARCH_PROVIDER=tavily

# OAuth Authentication Settings
# Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# JWT Settings
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Google Console "승인된 리디렉션 URI"와 정확히 일치해야 함 (HTTPS 사용 시)
GOOGLE_REDIRECT_URI=https://localhost:7860/api/auth/google/callback

# Naver OAuth
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
NAVER_REDIRECT_URI=http://localhost:7860/api/auth/naver/callback

# Kakao OAuth
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:7860/api/auth/kakao/callback

# Base URL for OAuth redirects (frontend URL)
BASE_URL=http://localhost:7860
FRONTEND_URL=http://localhost:3000
# When using ngrok or same-server: app is at /client/, set so OAuth redirect goes there (e.g. OAUTH_REDIRECT_PATH=client)
# OAUTH_REDIRECT_PATH=client
